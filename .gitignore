# Служебные файлы доски: живут только на этой машине, в набор не входят.
.kanban/.watcher-state.json
.kanban/.watcher-roles.json
.kanban/.watcher-pending.json
.kanban/.watcher-resume.json
.kanban/.workers.json
.kanban/worktrees.json

# Рабочие деревья задач лежат внутри проекта (bin/task-new.sh).
worktrees/
.worktrees/

# Python-кэш (создают painter/mockup-проверки)
__pycache__/

# macOS / IDE
.DS_Store
.idea/
*.log

# Локальные кэши проверки Rust-релея (создаются cargo test в песочнице)
.cargo-home/
.cargo-target/

# Локальные кэши проверки Swift-приложения (создаются swift test в песочнице)
.swift-cache/

# Локальный gradle-кэш проверок (sandbox: ~/.gradle недоступен)
.gradle-home/

# Кэши локального CI (bin/ci.sh): песочница не даёт писать в ~/.cargo, ~/.gradle
.ci-cache/
