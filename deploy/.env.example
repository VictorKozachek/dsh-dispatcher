# Скопируйте в deploy/.env и заполните. .env в git не попадает (см. .gitignore).

# Домен, указывающий A/AAAA-записью на этот сервер. Caddy выпустит TLS сам.
RELAY_DOMAIN=relay.example.com

# Токен агента (плагина dsh-remote): минимум 32 случайных байта.
#   openssl rand -hex 32
# Секрет: не коммитить, не переиспользовать между серверами.
RELAY_AGENT_TOKEN=change-me-openssl-rand-hex-32

# Необязательно: allowlist устройств через запятую (deviceId после привязки).
# Пусто — разрешены все привязанные устройства.
# RELAY_ALLOWED_DEVICES=

# Необязательно: TTL вопросов и кодов привязки (секунды).
# RELAY_QUESTION_TTL_SECONDS=1800
# RELAY_PAIRING_TTL_SECONDS=600

# Необязательно: часовой пояс контейнеров (логи/время).
# TZ=Europe/Moscow
